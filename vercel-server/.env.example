# ═══════════════════════════════════════════════════════
#  Environment Variables — Update Server
# ═══════════════════════════════════════════════════════

# Token de autenticação para endpoints admin
# Gere um token seguro: openssl rand -hex 32
ADMIN_TOKEN=sua-chave-secreta-aqui

# Vercel KV (opcional — para persistência entre deploys)
# Ative com: vercel kv enable
KV_REST_API_URL=
KV_REST_API_TOKEN=
